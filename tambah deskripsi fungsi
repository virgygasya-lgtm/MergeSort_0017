#include <iostream>
using namespace std;

int arr[20], B[20];
int n;

// Fungsi input()
// Membaca panjang array dengan validasi dan mengisi elemen array
void input() 
{
    do 
    {
        cout << "Masukkan panjang array (1-20): ";
        cin >> n;

        if (cin.fail() || n <= 0 || n > 20) 
        {
            cin.clear();
            cin.ignore(1000, '\n');
            cout << "Input tidak valid, coba lagi.\n";
            n = 0;
        }
    } while (n <= 0 || n > 20);

    for (int i = 0; i < n; i++) 
    {
        cout << "Array[" << i << "] = ";
        cin >> arr[i];
    }
}

// Fungsi mergeSort()
// Mengurutkan array dengan algoritma rekursif Merge Sort
void mergeSort(int low, int high) 
{
    if (low >= high) return;
    int mid = (low + high) / 2;

    mergeSort(low, mid);
    mergeSort(mid + 1, high);

    int i = low, j = mid + 1, k = low;
    while (i <= mid && j <= high) 
    {
        B[k++] = (arr[i] <= arr[j]) ? arr[i++] : arr[j++];
    }
    while (i <= mid) B[k++] = arr[i++];
    while (j <= high) B[k++] = arr[j++];

    for (int x = low; x <= high; x++) arr[x] = B[x];
}

// Fungsi output()
// Menampilkan hasil array setelah diurutkan
void output() 
{
    cout << "\n===============================" << endl;
    cout << "   Hasil Pengurutan Merge Sort " << endl;
    cout << "===============================\n";
    for (int i = 0; i < n; i++) 
    {
        cout << arr[i] << " ";
    }
    cout << "\n===============================\n";
}

// Fungsi main()
// Menjalankan alur: input → proses sort → output
int main() 
{
    input();
    mergeSort(0, n - 1);
    output();
    return 0;
}