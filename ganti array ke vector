#include <iostream>
#include <vector>
using namespace std;

vector<int> arr, B;
int n;

// Input data
void input() {
    cout << "Masukkan panjang array: ";
    cin >> n;
    arr.resize(n);
    B.resize(n);

    for (int i = 0; i < n; i++) 
    {
        cout << "Array[" << i << "] = ";
        cin >> arr[i];
    }
}

// Merge Sort
void mergeSort(int low, int high) 
{
    if (low >= high) return;
    int mid = (low + high) / 2;

    mergeSort(low, mid);
    mergeSort(mid + 1, high);

    int i = low, j = mid + 1, k = low;
    while (i <= mid && j <= high) 
    {
        B[k++] = (arr[i] <= arr[j]) ? arr[i++] : arr[j++];
    }
    while (i <= mid) B[k++] = arr[i++];
    while (j <= high) B[k++] = arr[j++];

    for (int x = low; x <= high; x++) arr[x] = B[x];
}

// Output hasil
void output() 
{
    cout << "\nHasil urut (Merge Sort): ";
    for (int i = 0; i < n; i++) cout << arr[i] << " ";
    cout << endl;
}

int main() 
{
    input();
    mergeSort(0, n - 1);
    output();
    return 0;
}