#include <iostream>
using namespace std;

int arr[20], B[20];
int n;

// Input data dengan validasi ukuran dan nilai
void input() 
{
    do 
    {
        cout << "Masukkan panjang array (1-20): ";
        cin >> n;

        if (cin.fail() || n <= 0 || n > 20) 
        {
            cin.clear();              // reset error flag
            cin.ignore(1000, '\n');   // buang input salah
            cout << "Input tidak valid, coba lagi.\n";
            n = 0; // reset agar loop lanjut
        }
    } while (n <= 0 || n > 20);

    for (int i = 0; i < n; i++) 
    {
        while (true) 
        {
            cout << "Array[" << i << "] = ";
            cin >> arr[i];
            if (cin.fail()) 
            {
                cin.clear();
                cin.ignore(1000, '\n');
                cout << "Harus angka, coba lagi.\n";
            } else 
            {
                break;
            }
        }
    }
}

// Merge Sort rekursif
void mergeSort(int low, int high) 
{
    if (low >= high) return;
    int mid = (low + high) / 2;

    mergeSort(low, mid);
    mergeSort(mid + 1, high);

    int i = low, j = mid + 1, k = low;
    while (i <= mid && j <= high) 
    {
        B[k++] = (arr[i] <= arr[j]) ? arr[i++] : arr[j++];
    }
    while (i <= mid) B[k++] = arr[i++];
    while (j <= high) B[k++] = arr[j++];

    for (int x = low; x <= high; x++) arr[x] = B[x];
}

// Output hasil
void output() 
{
    cout << "\nHasil urut (Merge Sort): ";
    for (int i = 0; i < n; i++) 
    {
        cout << arr[i] << " ";
    }
    cout << endl;
}

int main() 
{
    input();
    mergeSort(0, n - 1);
    output();
    return 0;
}