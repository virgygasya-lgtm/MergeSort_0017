#include <iostream>
#include <vector>
using namespace std;

vector<int> arr, B;
int n;
bool ascending = true;

// Input data (dengan opsi default)
void input(bool useDefault = false) 
{
    if (useDefault) 
    {
        arr = {10, 3, 7, 2, 9, 5};
        n = arr.size();
        B.resize(n);
        ascending = true; // default ascending
        cout << "Menggunakan array default untuk uji coba.\n";
        return;
    }

    cout << "Masukkan panjang array: ";
    cin >> n;
    arr.resize(n);
    B.resize(n);

    for (int i = 0; i < n; i++) 
    {
        cout << "Array[" << i << "] = ";
        cin >> arr[i];
    }

    char pilih;
    cout << "Urutkan ascending (a) atau descending (d)? ";
    cin >> pilih;
    ascending = (pilih == 'a' || pilih == 'A');
}

// Merge Sort
void mergeSort(int low, int high) 
{
    if (low >= high) return;
    int mid = (low + high) / 2;

    mergeSort(low, mid);
    mergeSort(mid + 1, high);

    int i = low, j = mid + 1, k = low;
    while (i <= mid && j <= high) 
    {
        if (ascending) 
        {
            B[k++] = (arr[i] <= arr[j]) ? arr[i++] : arr[j++];
        } else 
        {
            B[k++] = (arr[i] >= arr[j]) ? arr[i++] : arr[j++];
        }
    }
    while (i <= mid) B[k++] = arr[i++];
    while (j <= high) B[k++] = arr[j++];

    for (int x = low; x <= high; x++) arr[x] = B[x];
}

// Output hasil
void output() 
{
    cout << "\nHasil urut (Merge Sort): ";
    for (int i = 0; i < n; i++) cout << arr[i] << " ";
    cout << endl;
}

int main() 
{
    // true = gunakan array default untuk test cepat
    input(true);
    mergeSort(0, n - 1);
    output();
    return 0;
}