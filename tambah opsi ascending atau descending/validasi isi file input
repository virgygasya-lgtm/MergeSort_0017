#include <iostream>
#include <vector>
#include <fstream>
using namespace std;

vector<int> arr, B;
int n;
bool ascending = true;

// Input data (manual, default, atau file dengan validasi)
void input(int mode) 
{
    if (mode == 2) 
    { // default
        arr = {10, 3, 7, 2, 9, 5};
        n = arr.size();
        B.resize(n);
        ascending = true;
        cout << "Menggunakan array default.\n";
        return;
    }
    else if (mode == 3) 
    { // file
        ifstream file("input.txt");
        if (file.is_open()) 
        {
            if (!(file >> n) || n <= 0) 
            {
                cout << "Format file salah, gunakan input manual.\n";
            } else 
            {
                arr.resize(n);
                B.resize(n);
                for (int i = 0; i < n; i++) 
                {
                    if (!(file >> arr[i])) 
                    {
                        cout << "Data file tidak valid, gunakan input manual.\n";
                        arr.clear();
                        n = 0;
                        break;
                    }
                }
                if (n > 0 && !arr.empty()) {
                    ascending = true;
                    cout << "Data valid dibaca dari file input.txt\n";
                    file.close();
                    return;
                }
            }
            file.close();
        } else 
        {
            cout << "File input.txt tidak ditemukan, gunakan input manual.\n";
        }
    }

    // manual
    cout << "Masukkan panjang array: ";
    cin >> n;
    arr.resize(n);
    B.resize(n);

    for (int i = 0; i < n; i++) 
    {
        cout << "Array[" << i << "] = ";
        cin >> arr[i];
    }

    char pilih;
    cout << "Urutkan ascending (a) atau descending (d)? ";
    cin >> pilih;
    ascending = (pilih == 'a' || pilih == 'A');
}

// Merge Sort
void mergeSort(int low, int high) 
{
    if (low >= high) return;
    int mid = (low + high) / 2;

    mergeSort(low, mid);
    mergeSort(mid + 1, high);

    int i = low, j = mid + 1, k = low;
    while (i <= mid && j <= high) 
    {
        if (ascending) 
        {
            B[k++] = (arr[i] <= arr[j]) ? arr[i++] : arr[j++];
        } else 
        {
            B[k++] = (arr[i] >= arr[j]) ? arr[i++] : arr[j++];
        }
    }
    while (i <= mid) B[k++] = arr[i++];
    while (j <= high) B[k++] = arr[j++];

    for (int x = low; x <= high; x++) arr[x] = B[x];
}

// Output hasil
void output() 
{
    cout << "\nHasil urut (Merge Sort): ";
    for (int i = 0; i < n; i++) cout << arr[i] << " ";
    cout << endl;
}

int main() 
{
    int mode;
    cout << "Pilih mode input:\n1. Manual\n2. Default\n3. File\nPilihan: ";
    cin >> mode;

    input(mode);
    mergeSort(0, n - 1);
    output();
    return 0;
}